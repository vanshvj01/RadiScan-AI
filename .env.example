# ---------------------------------------------------------------------------
# RadiScan environment. Copy to .env and edit.
# Put comments on their OWN line -- some dotenv parsers fold a trailing
# "# comment" into the value.
# ---------------------------------------------------------------------------

DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Zero-infrastructure default. Swap for Postgres in production:
# DATABASE_URL=postgresql+psycopg2://radiscan:password@localhost:5432/radiscan
DATABASE_URL=sqlite:///./radiscan.db

# Celery runs tasks inline when eager. Set false and point at Redis for the
# production topology.
CELERY_EAGER=true
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# auto | cpu | cuda | cuda:0 | mps
DEVICE=auto

CHECKPOINT_PATH=models/checkpoints/best_model.pth
MC_DROPOUT_SAMPLES=20
HEATMAP_TOP_K=3

# Serve randomly-initialised weights when no checkpoint exists, so the UI can be
# demonstrated. Outputs are labelled "untrained-demo". Never enable in anything
# resembling production.
ALLOW_UNTRAINED=false

MAX_UPLOAD_MB=50

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU wheels by default -- a CUDA image would be ~6 GB. Override with
# --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu121 for GPU.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN pip install --index-url ${TORCH_INDEX} torch torchvision \
 && pip install -r requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
COPY services ./services
COPY configs ./configs
RUN pip install --no-deps -e .

# Run as a non-root user; the container writes only to data/ and models/.
RUN useradd -m -u 1000 radiscan && mkdir -p data models/checkpoints \
 && chown -R radiscan:radiscan /app
USER radiscan

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
  CMD curl -fsS http://localhost:8000/api/v1/health/live || exit 1

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
